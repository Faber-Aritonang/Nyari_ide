# === Database (Neon Postgres) ===
# Pooled connection string dari console.neon.tech (Connect → Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# === Auth (Better Auth) ===
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# URL publik app (dipakai untuk link share & callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Email reset password (opsional) ===
# Tanpa RESEND_API_KEY, link reset hanya dicatat di log server ([auth] LINK RESET PASSWORD)
RESEND_API_KEY=
RESEND_FROM=Nyari_ide <onboarding@resend.dev>

# === LLM ===
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# === Text-to-image (opsional) ===
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# === Embedding RAG (opsional; tanpa ini pakai embedding hash lokal) ===
OPENAI_API_KEY=

# === Migration-only (hanya untuk skrip impor dari Supabase lama) ===
